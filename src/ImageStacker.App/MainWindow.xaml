<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ImageStacker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Stacker"
        MinWidth="1100"
        MinHeight="720"
        Width="1280"
        Height="800"
        Background="#1E1E1E"
        Foreground="#E8E8E8"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top: input / output -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Input" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="InputFolderBox" Width="280" Margin="0,0,6,0"
                     TextChanged="FolderBox_TextChanged" />
            <Button x:Name="BrowseInputButton" Content="Browse&#8230;" Width="80" Margin="0,0,16,0" Click="BrowseInput_Click" />
            <TextBlock Text="Output" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="OutputFolderBox" Width="200" Margin="0,0,6,0" />
            <Button Content="Browse&#8230;" Width="80" Click="BrowseOutput_Click" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.6*" />
                <ColumnDefinition Width="5.4*" />
                <ColumnDefinition Width="*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- Left: layout + library -->
            <Grid Grid.Column="0" Margin="0,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Layout" Margin="0,0,0,6" Padding="6">
                    <UniformGrid x:Name="LayoutGrid" Columns="3" />
                </GroupBox>

                <GroupBox Grid.Row="1" Header="Photos" Padding="6">
                    <DockPanel>
                        <Button x:Name="RefreshPhotosButton"
                                DockPanel.Dock="Bottom"
                                Content="Refresh photos"
                                HorizontalAlignment="Left"
                                Margin="0,6,0,0"
                                Click="RefreshPhotos_Click" />
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button Content="Color on" Margin="0,0,4,4" Padding="6,2"
                                    Click="ColorOn_Click" />
                            <Button Content="Color off" Margin="0,0,4,4" Padding="6,2"
                                    Click="ColorOff_Click" />
                            <Button Content="Mono on" Margin="0,0,4,4" Padding="6,2"
                                    Click="MonoOn_Click" />
                            <Button Content="Mono off" Margin="0,0,4,4" Padding="6,2"
                                    Click="MonoOff_Click" />
                        </WrapPanel>
                        <ScrollViewer x:Name="ThumbScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="{StaticResource ThumbBackgroundBrush}">
                            <ItemsControl x:Name="ThumbList"
                                          Width="{Binding ActualWidth, ElementName=ThumbScroll}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemWidth="120" ItemHeight="88" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="116" Height="84" Margin="2"
                                                Background="{StaticResource ThumbBackgroundBrush}"
                                                BorderBrush="#555" BorderThickness="1"
                                                ToolTip="{Binding FileName}"
                                                PreviewMouseLeftButtonDown="Thumb_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="Thumb_PreviewMouseMove"
                                                PreviewMouseLeftButtonUp="Thumb_PreviewMouseLeftButtonUp">
                                            <Grid>
                                                <Grid>
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Opacity" Value="0.35" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Included}" Value="True">
                                                                    <Setter Property="Opacity" Value="1" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Image Source="{Binding Bitmap}"
                                                           Stretch="UniformToFill"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding FileName}"
                                                               VerticalAlignment="Bottom"
                                                               FontSize="9"
                                                               Foreground="#EEE"
                                                               Background="#99000000"
                                                               Padding="2,1"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <CheckBox IsChecked="{Binding Included, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Top"
                                                          Margin="1,0,0,0"
                                                          ToolTip="Include in batch, combo, and random" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </GroupBox>
            </Grid>

            <!-- Center: preview stage + deck -->
            <Grid Grid.Column="1" Margin="6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0"
                          Header="Preview"
                          Padding="6"
                          KeyDown="PreviewArea_KeyDown">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="PreviewPrevButton" Content="&#9664;" Width="32"
                                    Click="PreviewPrev_Click" IsEnabled="False" />
                            <TextBlock x:Name="PreviewNavText"
                                       Text="&#8212;"
                                       Width="120"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="6,0" />
                            <Button x:Name="PreviewNextButton" Content="&#9654;" Width="32"
                                    Click="PreviewNext_Click" IsEnabled="False" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                x:Name="StageBorder"
                                Background="{StaticResource StageBackgroundBrush}"
                                BorderBrush="#333"
                                BorderThickness="1"
                                MouseLeftButtonDown="Stage_MouseLeftButtonDown"
                                MouseMove="Stage_MouseMove"
                                MouseLeftButtonUp="Stage_MouseLeftButtonUp"
                                MouseRightButtonUp="Stage_MouseRightButtonUp">
                            <Grid>
                                <Image x:Name="StageImage"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                                <Canvas x:Name="StageOverlay"
                                        IsHitTestVisible="False"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                <TextBlock x:Name="StageEmptyText"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource SidebarMutedBrush}"
                                           FontSize="14"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="24"
                                           Text="Choose an input folder to preview collages." />
                            </Grid>
                        </Border>
                    </Grid>
                </GroupBox>

                <GroupBox x:Name="DeckPanel"
                          Grid.Row="1"
                          Header="Deck &#8212; tick cards to export"
                          Padding="6"
                          Margin="0,6,0,0"
                          Visibility="Collapsed">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,6">
                            <Button x:Name="DeckSelectAllButton"
                                    Content="Select all"
                                    Width="80"
                                    Margin="0,0,6,0"
                                    Click="DeckSelectAll_Click" />
                            <Button x:Name="DeckSelectNoneButton"
                                    Content="Select none"
                                    Width="88"
                                    Margin="0,0,12,0"
                                    Click="DeckSelectNone_Click" />
                            <TextBlock x:Name="DeckSelectionText"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource SidebarLabelBrush}" />
                        </StackPanel>

                        <ListBox x:Name="DeckList"
                                 Height="148"
                                 Background="#282828"
                                 BorderBrush="#444"
                                 BorderThickness="1"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.CanContentScroll="True"
                                 SelectionChanged="DeckList_SelectionChanged"
                                 PreviewMouseLeftButtonDown="DeckList_PreviewMouseLeftButtonDown">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="108"
                                            Height="132"
                                            Margin="3"
                                            BorderThickness="2"
                                            CornerRadius="2"
                                            Background="#333"
                                            BorderBrush="{Binding BorderBrush}"
                                            ToolTip="{Binding Label}">
                                        <Grid>
                                            <Image Source="{Binding PreviewBitmap}"
                                                   Stretch="Uniform"
                                                   Margin="4,4,4,22" />
                                            <TextBlock Text="&#8230;"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource SidebarMutedBrush}"
                                                       FontSize="18">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PreviewLoading}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding HasPreview}" Value="False" />
                                                                    <Condition Binding="{Binding PreviewLoading}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Setter Property="Text" Value="" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Top"
                                                      Margin="4,2,0,0"
                                                      Checked="DeckCardCheck_Changed"
                                                      Unchecked="DeckCardCheck_Changed"
                                                      PreviewMouseLeftButtonDown="DeckCheck_PreviewMouseLeftButtonDown" />
                                            <TextBlock Text="{Binding Label}"
                                                       VerticalAlignment="Bottom"
                                                       HorizontalAlignment="Stretch"
                                                       TextAlignment="Center"
                                                       FontSize="9"
                                                       Foreground="{StaticResource SidebarLabelBrush}"
                                                       Background="#88000000"
                                                       Padding="2,1"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </GroupBox>
            </Grid>

            <!-- Right: mode + run -->
            <Grid Grid.Column="2" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="Mode &amp; style" Padding="6" Foreground="#FFFFFF">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Mode" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#FFFFFF" />
                        <RadioButton x:Name="ModeSingle" Content="Single (count)" GroupName="Mode"
                                     IsChecked="True" Margin="0,2" Checked="Mode_Changed" />
                        <RadioButton x:Name="ModeBatch" Content="Batch all" GroupName="Mode"
                                     Margin="0,2" Checked="Mode_Changed" />
                        <RadioButton x:Name="ModeRandom" Content="Random &#215; count" GroupName="Mode"
                                     Margin="0,2" Checked="Mode_Changed" />
                        <RadioButton x:Name="ModeCombo" Content="Combo pack" GroupName="Mode"
                                     Margin="0,2" Checked="Mode_Changed" />
                        <RadioButton x:Name="ModeManual" Content="Blank collage" GroupName="Mode"
                                     Margin="0,2" Checked="Mode_Changed" />

                        <TextBlock Text="Count" Margin="0,10,0,4" Foreground="#FFFFFF" />
                        <TextBox x:Name="CountBox" Width="80" HorizontalAlignment="Left"
                                 Text="1" TextChanged="CountBox_TextChanged" />

                        <CheckBox x:Name="BorderlessCheck" Content="Borderless"
                                  Margin="0,10,0,4" Checked="Option_Changed" Unchecked="Option_Changed" />
                        <CheckBox x:Name="BleedCheck"
                                  Content="Bleed (soften seams)"
                                  Margin="0,4" Checked="Option_Changed" Unchecked="Option_Changed" />
                        <CheckBox x:Name="NoiseCheck" Content="Noise"
                                  Foreground="#FFFFFF"
                                  Margin="0,4" Checked="Effect_Changed" Unchecked="Effect_Changed" />
                        <CheckBox x:Name="OrtonCheck" Content="Orton"
                                  Foreground="#FFFFFF"
                                  Margin="0,4" Checked="Effect_Changed" Unchecked="Effect_Changed" />

                        <Expander Header="Advanced" IsExpanded="False" Foreground="#FFFFFF" Margin="0,8,0,0">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="Orton" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,4" />
                                <StackPanel x:Name="OrtonKnobsPanel">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" MinWidth="60" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Amount" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                        <Slider Grid.Column="1" Tag="OrtonAmount" Minimum="0" Maximum="1" Margin="6,0"
                                                ValueChanged="EffectKnobSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="EffectKnob_DragStarted"
                                                PreviewMouseLeftButtonUp="EffectKnob_DragEnded" />
                                        <TextBox Grid.Column="2" Tag="OrtonAmount" Margin="4,0,0,0"
                                                 LostFocus="EffectKnobBox_LostFocus" KeyDown="EffectKnobBox_KeyDown"
                                                 GotKeyboardFocus="EffectKnobBox_GotFocus" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" MinWidth="60" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Blur %" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                        <Slider Grid.Column="1" Tag="OrtonBlurPercent" Minimum="0.30" Maximum="1.80" Margin="6,0"
                                                ValueChanged="EffectKnobSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="EffectKnob_DragStarted"
                                                PreviewMouseLeftButtonUp="EffectKnob_DragEnded" />
                                        <TextBox Grid.Column="2" Tag="OrtonBlurPercent" Margin="4,0,0,0"
                                                 LostFocus="EffectKnobBox_LostFocus" KeyDown="EffectKnobBox_KeyDown"
                                                 GotKeyboardFocus="EffectKnobBox_GotFocus" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" MinWidth="60" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Mask low" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                        <Slider Grid.Column="1" Tag="OrtonMaskLow" Minimum="0" Maximum="1" Margin="6,0"
                                                ValueChanged="EffectKnobSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="EffectKnob_DragStarted"
                                                PreviewMouseLeftButtonUp="EffectKnob_DragEnded" />
                                        <TextBox Grid.Column="2" Tag="OrtonMaskLow" Margin="4,0,0,0"
                                                 LostFocus="EffectKnobBox_LostFocus" KeyDown="EffectKnobBox_KeyDown"
                                                 GotKeyboardFocus="EffectKnobBox_GotFocus" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" MinWidth="60" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Mask high" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                        <Slider Grid.Column="1" Tag="OrtonMaskHigh" Minimum="0" Maximum="1" Margin="6,0"
                                                ValueChanged="EffectKnobSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="EffectKnob_DragStarted"
                                                PreviewMouseLeftButtonUp="EffectKnob_DragEnded" />
                                        <TextBox Grid.Column="2" Tag="OrtonMaskHigh" Margin="4,0,0,0"
                                                 LostFocus="EffectKnobBox_LostFocus" KeyDown="EffectKnobBox_KeyDown"
                                                 GotKeyboardFocus="EffectKnobBox_GotFocus" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" MinWidth="60" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Feather %" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                        <Slider Grid.Column="1" Tag="OrtonFeatherPercent" Minimum="0" Maximum="1" Margin="6,0"
                                                ValueChanged="EffectKnobSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="EffectKnob_DragStarted"
                                                PreviewMouseLeftButtonUp="EffectKnob_DragEnded" />
                                        <TextBox Grid.Column="2" Tag="OrtonFeatherPercent" Margin="4,0,0,0"
                                                 LostFocus="EffectKnobBox_LostFocus" KeyDown="EffectKnobBox_KeyDown"
                                                 GotKeyboardFocus="EffectKnobBox_GotFocus" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="Noise" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,10,0,4" />
                                <StackPanel x:Name="NoiseKnobsPanel">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" MinWidth="60" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Amount" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                        <Slider Grid.Column="1" Tag="NoiseAmount" Minimum="0" Maximum="1" Margin="6,0"
                                                ValueChanged="EffectKnobSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="EffectKnob_DragStarted"
                                                PreviewMouseLeftButtonUp="EffectKnob_DragEnded" />
                                        <TextBox Grid.Column="2" Tag="NoiseAmount" Margin="4,0,0,0"
                                                 LostFocus="EffectKnobBox_LostFocus" KeyDown="EffectKnobBox_KeyDown"
                                                 GotKeyboardFocus="EffectKnobBox_GotFocus" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" MinWidth="60" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Size" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                        <Slider Grid.Column="1" Tag="NoiseSize" Minimum="0.40" Maximum="2.00" Margin="6,0"
                                                ValueChanged="EffectKnobSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="EffectKnob_DragStarted"
                                                PreviewMouseLeftButtonUp="EffectKnob_DragEnded" />
                                        <TextBox Grid.Column="2" Tag="NoiseSize" Margin="4,0,0,0"
                                                 LostFocus="EffectKnobBox_LostFocus" KeyDown="EffectKnobBox_KeyDown"
                                                 GotKeyboardFocus="EffectKnobBox_GotFocus" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" MinWidth="60" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Shadows" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                        <Slider Grid.Column="1" Tag="NoiseShadows" Minimum="0" Maximum="1" Margin="6,0"
                                                ValueChanged="EffectKnobSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="EffectKnob_DragStarted"
                                                PreviewMouseLeftButtonUp="EffectKnob_DragEnded" />
                                        <TextBox Grid.Column="2" Tag="NoiseShadows" Margin="4,0,0,0"
                                                 LostFocus="EffectKnobBox_LostFocus" KeyDown="EffectKnobBox_KeyDown"
                                                 GotKeyboardFocus="EffectKnobBox_GotFocus" />
                                    </Grid>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" MinWidth="60" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Highlights" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                        <Slider Grid.Column="1" Tag="NoiseHighlights" Minimum="0" Maximum="1" Margin="6,0"
                                                ValueChanged="EffectKnobSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="EffectKnob_DragStarted"
                                                PreviewMouseLeftButtonUp="EffectKnob_DragEnded" />
                                        <TextBox Grid.Column="2" Tag="NoiseHighlights" Margin="4,0,0,0"
                                                 LostFocus="EffectKnobBox_LostFocus" KeyDown="EffectKnobBox_KeyDown"
                                                 GotKeyboardFocus="EffectKnobBox_GotFocus" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <TextBlock Text="Color" Margin="0,10,0,4" Foreground="#FFFFFF" />
                        <ComboBox x:Name="ColorCombo"
                                  Width="160"
                                  MaxDropDownHeight="240"
                                  IsEditable="True"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="ColorCombo_SelectionChanged" />

                        <TextBlock x:Name="StatusText"
                                   Text="Ready."
                                   TextWrapping="Wrap"
                                   Margin="0,14,0,0"
                                   Foreground="#FFFFFF" />
                    </StackPanel>
                    </ScrollViewer>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="Run" Padding="6" Margin="0,10,0,0" Foreground="#FFFFFF">
                    <StackPanel>
                        <TextBlock x:Name="RunInfoText" TextWrapping="Wrap" Foreground="#FFFFFF" />
                        <ProgressBar x:Name="RunProgress"
                                     Height="16"
                                     Margin="0,8,0,0"
                                     Minimum="0"
                                     Maximum="1"
                                     Visibility="Collapsed" />
                        <TextBlock x:Name="RunWorkingText"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Foreground="#FFFFFF" />
                        <Button Content="Shortcuts&#8230;" Margin="0,8,0,0" Click="Shortcuts_Click" />
                        <Button x:Name="RunButton" Content="Run" Margin="0,10,0,0"
                                FontWeight="SemiBold" Click="Run_Click" />
                        <Button x:Name="OpenOutputButton"
                                Content="Open output folder"
                                Margin="0,6,0,0"
                                IsEnabled="False"
                                Click="OpenOutput_Click" />
                    </StackPanel>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</Window>

