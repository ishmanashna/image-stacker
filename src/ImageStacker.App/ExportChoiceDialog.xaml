<Window x:Class="ImageStacker.App.ExportChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export"
        Width="420"
        Height="200"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Which collages should be exported?"
                   TextWrapping="Wrap"
                   FontWeight="SemiBold" />
        <TextBlock x:Name="SubtitleText"
                   Grid.Row="1"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap"
                   Foreground="#AAA" />
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="CurrentButton"
                    Content="Export current"
                    MinWidth="110"
                    Margin="0,0,8,0"
                    Click="Current_Click" />
            <Button x:Name="AllButton"
                    Content="Export all"
                    MinWidth="110"
                    Margin="0,0,8,0"
                    Click="All_Click" />
            <Button Content="Cancel"
                    MinWidth="72"
                    IsCancel="True"
                    Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
